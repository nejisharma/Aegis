{
  "expo": {
    "name": "Aegis Intel",
    "slug": "aegis",
    "scheme": "aegis",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#060a13",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ca.neeraj.aegis",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Aegis Threat Intel does not track or use your location. The map library includes optional location support, which this app never turns on."
      },
      "associatedDomains": [
        "applinks:aegis.neeraj.ca"
      ],
      "appleTeamId": "57CT2U4766"
    },
    "android": {
      "package": "ca.neeraj.aegis",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#060a13"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aegis.neeraj.ca",
              "pathPrefix": "/cve/"
            },
            {
              "scheme": "https",
              "host": "aegis.neeraj.ca",
              "pathPrefix": "/news"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060a13",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22d3ee",
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/withReleaseSigning",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CriticalCve",
              "label": "Aegis · Critical CVEs",
              "description": "The 3 newest critical CVEs and your watchlist hits, refreshed every 30 minutes.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a6c3eb2-a5d9-497b-b3a0-9f7a0d5bdb86"
      }
    },
    "owner": "nejisharma"
  }
}
